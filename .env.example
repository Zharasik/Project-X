DATABASE_URL="postgresql://postgres:postgres@localhost:5432/designlab?schema=public"
# Direct (non-pooled) connection used by migrations. Locally — the same URL.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/designlab?schema=public"
# At least 32 characters. Generate: openssl rand -base64 32
SESSION_SECRET=""
# Local storage driver directory for uploaded practice files
UPLOAD_DIR="./storage/uploads"

# Vercel Blob (production). When set, practice files are stored in Blob instead of UPLOAD_DIR.
# BLOB_READ_WRITE_TOKEN=""
# Must match the store access mode chosen in Vercel: private (recommended) or public
# BLOB_ACCESS="private"
# Timezone used to decide what "today" is
# APP_TIMEZONE="Asia/Almaty"
